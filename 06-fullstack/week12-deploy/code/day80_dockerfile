"""
day80_dockerfile — FastAPI 应用的 Docker 镜像构建文件
=======================================================
知识点：
  1. Dockerfile 基本指令：FROM, WORKDIR, COPY, RUN, CMD
  2. 多阶段构建的概念
  3. Python 依赖缓存优化
  4. 最小化镜像体积（使用 slim 版本）

构建命令:
  docker build -t fastapi-app -f day80_dockerfile .

运行命令:
  docker run -d --name my-api -p 8000:8000 fastapi-app

查看运行中容器:
  docker ps

查看日志:
  docker logs my-api

生产建议:
  - 使用 .dockerignore 排除不必要的文件（__pycache__, .env, .git 等）
  - 使用非 root 用户运行容器（安全性）
  - 结合 CI/CD 自动构建和推送镜像
"""

# ===================================================================
# Dockerfile 内容（以注释形式编写，可保存为独立的 Dockerfile 文件）
# ===================================================================
#
# ```dockerfile
# # ================================================================
# # 第一阶段：基础镜像
# # ================================================================
# # 使用 Python 3.12 的 slim 版本（体积小，安全性高）
# # slim 版本删除了不必要的包，但保留了 pip 和常用功能
# FROM python:3.12-slim
#
# # ================================================================
# # 设置工作目录
# # ================================================================
# # 所有后续命令（COPY, RUN, CMD）都会在此目录下执行
# WORKDIR /app
#
# # ================================================================
# # 复制依赖文件
# # ================================================================
# # 先复制 requirements.txt（利用 Docker 层缓存）
# # 只要 requirements.txt 不变，此层就不会重新构建
# COPY requirements.txt .
#
# # ================================================================
# # 安装 Python 依赖
# # ================================================================
# # --no-cache-dir: 不缓存下载的包，减小镜像体积
# RUN pip install --no-cache-dir -r requirements.txt
#
# # ================================================================
# # 复制应用代码
# # ================================================================
# # 将当前目录（构建上下文）中的所有文件复制到 /app
# COPY . .
#
# # ================================================================
# # 启动命令
# # ================================================================
# # 使用 uvicorn 运行 FastAPI 应用
# # main:app    — main.py 中的 app 实例
# # --host 0.0.0.0 — 监听所有网络接口（容器内必须这样设置）
# # --port 8000    — 监听端口
# CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
# ```

# ===================================================================
# 配套文件：requirements.txt
# ===================================================================
# 在同目录下创建 requirements.txt，内容如下：
#
# fastapi==0.115.0
# uvicorn[standard]==0.30.0
# passlib[bcrypt]==1.7.4
# python-jose[cryptography]==3.3.0
# pydantic==2.9.0
# python-multipart==0.0.12
# python-dotenv==1.0.1

# ===================================================================
# 配套文件：.dockerignore
# ===================================================================
# 在同目录下创建 .dockerignore，排除不需要的文件：
#
# __pycache__/
# *.pyc
# *.pyo
# .env
# .git/
# .gitignore
# .DS_Store
# logs/
# *.md
# venv/
# .venv/
# .idea/
# .vscode/

# ===================================================================
# 直接运行此 Python 脚本会打印 Dockerfile 内容
# ===================================================================
if __name__ == "__main__":
    dockerfile_content = r"""FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY . .

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
"""
    print("=" * 60)
    print("Dockerfile 内容")
    print("=" * 60)
    print(dockerfile_content)

    print("\n使用说明:")
    print("  1. 将上述内容保存为 Dockerfile")
    print("  2. 在同目录下创建 requirements.txt")
    print("  3. 构建镜像:")
    print("     docker build -t fastapi-app .")
    print("  4. 运行容器:")
    print("     docker run -d -p 8000:8000 fastapi-app")
    print("  5. 访问 http://localhost:8000/docs")
